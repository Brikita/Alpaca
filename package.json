{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --test --experimental-strip-types tests/*.test.*",
    "test:scheduler": "node scripts/check-scheduler.mjs",
    "snapshot:alpaca": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/alpaca-snapshot.ts",
    "scan:options": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/option-scan.ts",
    "evaluate:latest": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/evaluate-latest-scan.ts",
    "execute:latest": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/execute-latest-paper-order.ts",
    "monitor:position": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/monitor-open-paper-position.ts",
    "reconcile:orders": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/reconcile-paper-orders.ts",
    "replay:strategy": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/run-strategy-replay.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.3",
    "vite": "^8.0.13",
    "wrangler": "^4.92.0"
  },
  "type": "module"
}
