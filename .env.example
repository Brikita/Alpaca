# Alpaca paper credentials. Never commit real values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_CLI_PATH=

# VolGuard blocks live routing even if another profile enables it.
ALPACA_LIVE_TRADE=false

# Keep false during development. Set exactly "paper" only after dry-run review.
VOLGUARD_EXECUTION_ENABLED=false

# Sanitized telemetry publishing. The token is separate from Alpaca credentials.
VOLGUARD_TELEMETRY_URL=
VOLGUARD_SCAN_URL=
VOLGUARD_ORDER_EVENT_URL=
VOLGUARD_TELEMETRY_TOKEN=

# Required only while the hosted Site is owner-only. Keep secret and local.
VOLGUARD_SITES_BYPASS_TOKEN=
