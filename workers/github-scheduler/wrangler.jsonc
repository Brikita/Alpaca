{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "volguard-github-scheduler",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["2-59/5 13-22 * * mon-fri"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "AUTOMATION_CONTROL", "class_name": "AutomationControl" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AutomationControl"] }
  ],
  "vars": {
    "GITHUB_OWNER": "Brikita",
    "GITHUB_REPO": "Alpaca",
    "GITHUB_WORKFLOW": "monitor-paper-position.yml",
    "GITHUB_REF": "master",
    "DASHBOARD_ORIGIN": "https://volguard-ai.briankinyua0101.chatgpt.site"
  }
}
